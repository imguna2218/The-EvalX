# Maximum number of concurrent Docker containers
MAX_CONCURRENT_CONTAINERS=200

# Size of the container pool per language
CONTAINER_POOL_SIZE=20

# Dynamic pool scaling thresholds
POOL_SCALE_UP_THRESHOLD=90
POOL_SCALE_DOWN_THRESHOLD=10
POOL_SCALE_FACTOR=5

DEFAULT_TIMEOUT=10
DEFAULT_MEMORY=512m

# Redis connection details
REDIS_HOST=redis
REDIS_PORT=6379
MAX_REQUESTS=20