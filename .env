MAX_CONCURRENT_SANDBOXES=25

# Size of the container pool per language
CONTAINER_POOL_SIZE=20

# Dynamic pool scaling thresholds
POOL_SCALE_UP_THRESHOLD=90
POOL_SCALE_DOWN_THRESHOLD=10
POOL_SCALE_FACTOR=5

DEFAULT_TIMEOUT=1
DEFAULT_MEMORY=512m

# Redis connection details
REDIS_HOST=localhost
REDIS_PORT=6379
MAX_REQUESTS=20

# ADDED: The number of worker replicas defined in docker-compose.yml
WORKER_REPLICAS=4

# System Compatibilities 
HYSTERESIS_SECONDS=15 # COOLDOWN PERIOD
QUEUE_DEPTH_THRESHOLD=20 #20 REQUESTS
MEMORY_USAGE_THRESHOLD=80 #80% FOR NOW 

# ADDED: Configuration for task retries and Dead Letter Queue
MAX_RETRIES=3
DEAD_LETTER_QUEUE_NAME="evalx:dead_letter_queue"


# Redis TTL configurations
RESULT_TTL_SECONDS=200
DEFAULT_ARTIFACT_TTL_SECONDS=200
JAVA_ARTIFACT_TTL_SECONDS=200


